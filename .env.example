# Copy to .env (never commit .env). PowerShell:  Copy-Item .env.example .env
# All paths are relative to the repository root unless absolute.

# Required. Bearer token for every /api/v1 call. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-token

# SQLite file = operational source of truth for inventory and meal sessions.
DATABASE_PATH=data/poc.sqlite3

# Meal photos and uploads (gitignored). Keep outside the repo in production-like tests.
UPLOAD_DIR=uploads

# Upload limits
MAX_UPLOAD_MB=15

# Delete meal sessions/photos older than N days with scripts/purge_uploads.py
MEAL_RETENTION_DAYS=14

# Nutrition reference CSVs loaded at startup (public MFDS-derived rows first, DEMO rows last)
NUTRITION_CSV=sample-data/nutrition_reference_public.csv,sample-data/nutrition_demo.csv

# Optional: MFDS (식약처) 식품영양성분DB OpenAPI via data.go.kr. Leave empty to disable.
# Endpoint changed on 2026-09-18 to FoodNtrCpntDbInfo03 (old 02 URL kept 90 days).
# Operation name and field names are NOT VERIFIED in this PoC — check 출력메세지.xlsx.
MFDS_API_KEY=
MFDS_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo03
MFDS_OPERATION=getFoodNtrCpntDbInq03

# Optional OCR for product photos (requires Tesseract installed on the server)
OCR_ENABLED=true
OCR_LANG=eng

# Optional open-source segmentation plugin: none | sam2 | foodsam
FOOD_MODEL_PLUGIN=none

# Server bind (uvicorn). Expose to the glasses only through HTTPS (see docs/aiui-studio-deploy.md).
HOST=127.0.0.1
PORT=8000

# Meal diary: timezone for 오늘/어제 and date validation
APP_TIMEZONE=Asia/Seoul

# Inventory <-> Excel sync (SERVER mode only). Empty = disabled.
# Point it at a file inside a OneDrive / Google Drive / SharePoint synced folder on the server PC, e.g.
#   INVENTORY_XLSX_PATH=C:\Users\me\OneDrive\Rokid\inventory.xlsx   (default example below stays inside data/)
INVENTORY_XLSX_PATH=
# INVENTORY_XLSX_PATH=data/inventory_sync.xlsx
# Seconds between background sync steps. Unset/empty = 30. 0 = background poller explicitly OFF
# (then sync runs only at startup and from /admin/inventory-sync / POST /api/v1/inventory/excel-sync)
INVENTORY_XLSX_POLL_SECONDS=30
# merge_delta (default) | db_wins | excel_wins
INVENTORY_XLSX_MERGE_POLICY=merge_delta
# true (default) = the poller applies SAFE Excel edits automatically: known export_id baseline, no conflict,
# no invalid row. Anything else -> state needs_review: nothing applied, the file is not overwritten, DB changes
# wait as a pending export until the file is fixed or you press Apply on http://<server>/admin/inventory-sync
# false = every Excel edit waits for that Apply button
INVENTORY_XLSX_AUTO_APPLY=true
