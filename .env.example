# Copy to .env (never commit .env). PowerShell:  Copy-Item .env.example .env
# All paths are relative to the repository root unless absolute.

# Required. Bearer token for every /api/v1 call. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-token

# SQLite file = operational source of truth for inventory and meal sessions.
DATABASE_PATH=data/poc.sqlite3

# Meal photos and uploads (gitignored). Keep outside the repo in production-like tests.
UPLOAD_DIR=uploads

# Upload limits
MAX_UPLOAD_MB=15

# Delete meal sessions/photos older than N days with scripts/purge_uploads.py
MEAL_RETENTION_DAYS=14

# Nutrition reference seed (DEMO mock values unless replaced)
NUTRITION_CSV=sample-data/nutrition_demo.csv

# Optional: MFDS (식약처) 식품영양성분DB OpenAPI via data.go.kr. Leave empty to disable.
# Endpoint changed on 2026-09-18 to FoodNtrCpntDbInfo03 (old 02 URL kept 90 days).
# Operation name and field names are NOT VERIFIED in this PoC — check 출력메세지.xlsx.
MFDS_API_KEY=
MFDS_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo03
MFDS_OPERATION=getFoodNtrCpntDbInq03

# Optional OCR for product photos (requires Tesseract installed on the server)
OCR_ENABLED=true
OCR_LANG=eng

# Optional open-source segmentation plugin: none | sam2 | foodsam
FOOD_MODEL_PLUGIN=none

# Server bind (uvicorn). Expose to the glasses only through HTTPS (see docs/aiui-studio-deploy.md).
HOST=127.0.0.1
PORT=8000
